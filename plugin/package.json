{
  "name": "dsh-tray-notify",
  "version": "0.1.0",
  "description": "DeepSeek-Harness 插件：把会话事件按策略写入 spool，由托盘统一投递桌面通知。",
  "type": "module",
  "private": true,
  "keywords": [
    "dsh",
    "dsh-plugin",
    "notification",
    "tray"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "dsh.bundle.patch"
    },
    "client": {
      "platform": "web"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": "./dist/client.js"
  },
  "files": [
    "dist",
    "dsh.bundle.patch",
    "scripts/build-client.mjs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && node scripts/build-client.mjs",
    "test": "node --test",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-goal": "0.2.1-rc.5",
    "@deepseek-ai/dsh-jobs": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.5",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.5",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.5",
    "@deepseek-ai/dsh-user-questions": "0.2.1-rc.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-goal": "0.2.1-rc.5",
    "@deepseek-ai/dsh-home-paths": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-jobs": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-title": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.5",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.5",
    "@deepseek-ai/dsh-user-questions": "0.2.1-rc.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  }
}
